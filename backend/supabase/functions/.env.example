# Secrets for the Edge Functions. Copy to supabase/functions/.env, fill in, then run:
#   npm run secrets:set
# (SUPABASE_URL and the service key are provided by Supabase automatically.)

# --- Email (Resend, https://resend.com) — booking/enquiry emails to your team and customers
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=info@mountainplanetnepal.com
# Must use a domain you verified in Resend, e.g. Mountain Planet <app@mountainplanetnepal.com>
ENQUIRY_FROM_EMAIL=

# --- Khalti (Nepal wallet, pays in NPR) — https://admin.khalti.com
KHALTI_SECRET_KEY=
# Sandbox while testing; for live payments use https://khalti.com/api/v2
KHALTI_BASE=https://dev.khalti.com/api/v2
# Exchange rate you charge at when converting a USD price to NPR, e.g. 133.5
KHALTI_USD_TO_NPR=

# --- Stripe (cards, pays in USD) — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# --- Planet AI (Claude) — https://console.anthropic.com → API keys
# Without it the app uses its built-in rule-based assistant.
ANTHROPIC_API_KEY=
