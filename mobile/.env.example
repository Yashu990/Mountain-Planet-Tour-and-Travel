# Backend connection (see ../backend/README.md). Copy to mobile/.env and fill in.
# Leave empty to run the app fully offline on its bundled content.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: crash reports (sentry.io → project → Client Keys / DSN)
EXPO_PUBLIC_SENTRY_DSN=
# Optional: anonymous usage analytics (posthog.com → project API key)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
